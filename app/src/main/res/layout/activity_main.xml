<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/surface_base">

    <TextView
        android:id="@+id/app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AuraLine"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/motor_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motor: APAGADO"
        android:textSize="18sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <Switch
        android:id="@+id/motor_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Motor de audio"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_equalizer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ecualizador (20-25 bandas)"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Controles (balance, estéreo, volumen)"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_effects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Efectos (reverb, compresor)"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ajustes (paleta de colores)"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conecta tu Samsung S21 Ultra y pulsa un botón para comenzar."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

</LinearLayout>
